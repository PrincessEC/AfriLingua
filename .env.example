# AfriLingua v2 configuration. Copy to `.env` and edit. Every value is optional.
# v1 variable names (MODEL_NLLB, DEVICE, HF_CACHE, ...) still work.

# ── Hardware ──────────────────────────────────────────────────────────────────
# auto | cpu | cuda. CPU is the primary target; a GPU is used automatically if present.
DEVICE=auto
# auto | float32 | float16 | int8. auto = int8 on CPU, float16 on GPU.
TORCH_DTYPE=auto
# auto | cpu-lite (≤8 GB RAM) | cpu-standard | gpu
AFRILINGUA_PROFILE=auto
# adaptive | all | minimal: what to load at startup (everything else loads on first use)
PRELOAD_MODE=adaptive
# 0 = automatic
CPU_THREADS=0

# ── Backends ──────────────────────────────────────────────────────────────────
# auto picks the fast int8 backend when installed (pip install "afrilingua[fast]")
MT_BACKEND=auto            # auto | ctranslate2 | transformers
ASR_EN_BACKEND=auto        # auto | faster-whisper | openai-whisper
TTS_EN_BACKEND=auto        # auto | mms | pyttsx3

# ── Models (empty = chosen from the hardware profile) ─────────────────────────
MODEL_NLLB=
MODEL_WHISPER=
MODEL_MMS_ASR=facebook/mms-1b-all
MODEL_MMS_TTS_ENGLISH=facebook/mms-tts-eng
# Optional semantic embedder for the translation memory (default: fast char n-gram vectors)
MODEL_EMBEDDER=

LIVE_BEAM_SIZE=1
DOCUMENT_BEAM_SIZE=4

# ── Extra languages (no code changes) ─────────────────────────────────────────
# LANGUAGE_REGISTRY_FILE=./languages.json
# AFRILINGUA_EXTRA_LANGUAGES=[{"name":"swahili","nllb_code":"swh_Latn","mms_asr_code":"swh","mms_tts_model":"facebook/mms-tts-swh","aliases":["sw"]}]
LANGUAGE_REGISTRY_FILE=
AFRILINGUA_EXTRA_LANGUAGES=

# ── Paths ─────────────────────────────────────────────────────────────────────
HF_CACHE=./models/cache
CT2_CACHE=./models/ct2
DATA_DIR=./data
FINETUNED_MODEL_DIR=./data/finetuned/nllb-afrilingua

# ── Audio / live interpretation ───────────────────────────────────────────────
SAMPLE_RATE=16000
VAD_THRESHOLD=0.5
VAD_SILENCE_S=0.6
VAD_MAX_UTTERANCE_S=8.0
VAD_PREROLL_S=0.3

# ── Translation memory ────────────────────────────────────────────────────────
TM_EXACT_THRESHOLD=0.97
TM_FUZZY_THRESHOLD=0.80

# ── Server ────────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated keys. Empty = local mode without auth. Set this before using --lan.
API_KEYS=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=25
# 1 = never touch the network (after `afrilingua models pull`)
AFRILINGUA_OFFLINE=0
