# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit it.

# ── Device ────────────────────────────────────────────────────────────────────
# Options: cpu | cuda | auto
#   cpu   → force CPU regardless of hardware
#   cuda  → force GPU (falls back to CPU if CUDA unavailable)
#   auto  → use GPU if available, otherwise CPU  (recommended)
DEVICE=auto

# Options: float32 | float16 | auto
#   auto  → float16 on GPU (2x faster, half the VRAM), float32 on CPU
#   float16 requires a CUDA-capable GPU
TORCH_DTYPE=auto

# ── Deployment ────────────────────────────────────────────────────────────────
# Options: web | desktop
#   web     → Gradio browser UI + FastAPI backend (default)
#   desktop → PyQt6 native desktop application (requires PyQt6 + pyinstaller)
DEPLOYMENT_MODE=web

# ── Model IDs ─────────────────────────────────────────────────────────────────
MODEL_NLLB=facebook/nllb-200-distilled-600M
MODEL_WHISPER=openai/whisper-small
MODEL_MMS_ASR=facebook/mms-300m
MODEL_MMS_TTS_IGBO=facebook/mms-tts-ibo
MODEL_MMS_TTS_YORUBA=facebook/mms-tts-yor
MODEL_MMS_TTS_HAUSA=facebook/mms-tts-hau

# ── Local paths ───────────────────────────────────────────────────────────────
HF_CACHE=./models/cache
FINETUNED_MODEL_DIR=./data/finetuned/nllb-afrilingua
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed

# ── Audio ─────────────────────────────────────────────────────────────────────
SAMPLE_RATE=16000
VAD_THRESHOLD=0.5
CHUNK_DURATION_S=0.5

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ── UI ────────────────────────────────────────────────────────────────────────
GRADIO_PORT=7860
