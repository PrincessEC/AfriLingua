# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit it.

# ── Device ────────────────────────────────────────────────────────────────────
# Options: cpu | cuda | auto
#   cpu   → force CPU regardless of hardware
#   cuda  → force GPU (falls back to CPU if CUDA unavailable)
#   auto  → use GPU if available, otherwise CPU  (recommended)
DEVICE=auto

# Options: float32 | float16 | auto
#   auto  → float16 on GPU (2x faster, half the VRAM), float32 on CPU
#   float16 requires a CUDA-capable GPU
TORCH_DTYPE=auto

# ── Deployment ────────────────────────────────────────────────────────────────
# Options: web | desktop
#   web     → Gradio browser UI + FastAPI backend (default)
#   desktop → PyQt6 native desktop application (requires PyQt6 + pyinstaller)
DEPLOYMENT_MODE=web

# Options: adaptive | all | minimal
#   adaptive -> preload speech models only on high-VRAM GPUs, lazy-load elsewhere
#   all      -> preload every configured model at startup
#   minimal  -> preload only the translation model; speech/TTS load when first used
PRELOAD_MODE=adaptive

# ── Model IDs ─────────────────────────────────────────────────────────────────
MODEL_NLLB=facebook/nllb-200-distilled-600M
MODEL_WHISPER=openai/whisper-small
MODEL_MMS_ASR=facebook/mms-1b-all
MODEL_MMS_TTS_IGBO=rnjema-unima/mms-tts-ibo-baseline
MODEL_MMS_TTS_YORUBA=facebook/mms-tts-yor
MODEL_MMS_TTS_HAUSA=facebook/mms-tts-hau

# Optional: add more languages without code changes.
# Set LANGUAGE_REGISTRY_FILE to a JSON file, or inline JSON in AFRILINGUA_EXTRA_LANGUAGES.
# Example:
# [{"name":"swahili","nllb_code":"swh_Latn","mms_asr_code":"swh","mms_tts_model":"facebook/mms-tts-swh","aliases":["kiswahili"],"detection_words":["habari","asante"]}]
LANGUAGE_REGISTRY_FILE=
AFRILINGUA_EXTRA_LANGUAGES=

# ── Local paths ───────────────────────────────────────────────────────────────
HF_CACHE=./models/cache
FINETUNED_MODEL_DIR=./data/finetuned/nllb-afrilingua
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed

# ── Audio ─────────────────────────────────────────────────────────────────────
SAMPLE_RATE=16000
VAD_THRESHOLD=0.5
CHUNK_DURATION_S=0.5

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ── UI ────────────────────────────────────────────────────────────────────────
GRADIO_PORT=7860
